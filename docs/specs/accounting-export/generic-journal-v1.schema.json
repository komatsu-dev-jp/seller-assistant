{
  "schemaVersion": "generic_journal_v1.0.0",
  "compatibilityStatus": "application_owned_contract",
  "serialization": {
    "mediaType": "text/csv",
    "encoding": "UTF-8",
    "bom": true,
    "lineEnding": "CRLF",
    "delimiter": ",",
    "quote": "double_quote",
    "escape": "double_embedded_quotes",
    "quoteRule": "quote_if_field_contains_delimiter_quote_cr_or_lf",
    "finalLineEnding": true
  },
  "columns": [
    { "index": 1, "label": "export_batch_id", "required": true, "rule": "opaque_internal_id" },
    { "index": 2, "label": "source_event_id", "required": true, "rule": "opaque_internal_id_unique_within_batch" },
    { "index": 3, "label": "transaction_date", "required": true, "rule": "yyyy-MM-dd" },
    { "index": 4, "label": "debit_account", "required": true, "maxChars": 100 },
    { "index": 5, "label": "debit_subaccount", "required": false, "maxChars": 100 },
    { "index": 6, "label": "debit_tax_category", "required": true, "rule": "approved_profile_value_or_explicit_not_applicable" },
    { "index": 7, "label": "debit_invoice_category", "required": true, "rule": "approved_profile_value_or_explicit_not_applicable" },
    { "index": 8, "label": "debit_amount_jpy", "required": true, "rule": "positive_integer" },
    { "index": 9, "label": "credit_account", "required": true, "maxChars": 100 },
    { "index": 10, "label": "credit_subaccount", "required": false, "maxChars": 100 },
    { "index": 11, "label": "credit_tax_category", "required": true, "rule": "approved_profile_value_or_explicit_not_applicable" },
    { "index": 12, "label": "credit_invoice_category", "required": true, "rule": "approved_profile_value_or_explicit_not_applicable" },
    { "index": 13, "label": "credit_amount_jpy", "required": true, "rule": "positive_integer" },
    { "index": 14, "label": "description", "required": true, "maxChars": 200, "rule": "no_address_no_secret_no_raw_receipt_text" },
    { "index": 15, "label": "evidence_reference_id", "required": true, "rule": "opaque_internal_id" },
    { "index": 16, "label": "mapping_rule_version", "required": true },
    { "index": 17, "label": "financial_formula_version", "required": true },
    { "index": 18, "label": "human_confirmed_by", "required": true, "rule": "opaque_internal_actor_id" },
    { "index": 19, "label": "human_confirmed_at", "required": true, "rule": "RFC3339_with_offset" }
  ],
  "groupRules": [
    "header_labels_and_order_are_immutable",
    "debit_total_equals_credit_total",
    "same_batch_duplicate_source_event_id_is_hard_block",
    "past_batch_same_source_set_or_hash_requires_explicit_confirmation_new_batch_id_and_supersedes_reference"
  ]
}
