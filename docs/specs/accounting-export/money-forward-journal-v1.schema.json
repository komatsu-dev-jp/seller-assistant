{
  "schemaVersion": "money_forward_journal_v1.0.0",
  "sourceCheckedAt": "2026-08-20",
  "sourceUrl": "https://biz.moneyforward.com/support/account/guide/import-books/ib01.html",
  "sourcePageUpdatedAt": "2026-07-09",
  "compatibilityStatus": "manual_import_not_yet_verified",
  "serialization": {
    "mediaType": "text/csv",
    "encoding": "UTF-8",
    "bom": true,
    "lineEnding": "CRLF",
    "delimiter": ",",
    "quote": "double_quote",
    "escape": "double_embedded_quotes",
    "quoteRule": "quote_if_field_contains_delimiter_quote_cr_or_lf",
    "finalLineEnding": true
  },
  "columns": [
    { "index": 1, "label": "取引No", "required": false, "rule": "blank_or_1_to_9_ascii_digits" },
    { "index": 2, "label": "取引日", "required": true, "rule": "yyyy/MM/dd_within_selected_fiscal_year" },
    { "index": 3, "label": "借方勘定科目", "required": "unless_compound_row_debit_side_blank", "maxChars": 30 },
    { "index": 4, "label": "借方補助科目", "required": false, "maxChars": 30 },
    { "index": 5, "label": "借方部門", "required": false, "maxChars": 20 },
    { "index": 6, "label": "借方取引先", "required": false, "maxChars": 255 },
    { "index": 7, "label": "借方税区分", "required": "app_requires_explicit_approved_value_when_debit_side_present", "rule": "approved_profile_value_exact_match" },
    { "index": 8, "label": "借方インボイス", "required": "app_requires_explicit_approved_value_when_debit_side_present", "allowed": ["適格", "80％控除", "70％控除", "50％控除", "30％控除", "控除なし"], "rule": "date_eligibility_required" },
    { "index": 9, "label": "借方金額(円)", "required": "unless_compound_row_debit_side_blank", "rule": "positive_jpy_integer" },
    { "index": 10, "label": "借方税額", "required": false, "allowed": ["", "0"] },
    { "index": 11, "label": "貸方勘定科目", "required": "unless_compound_row_credit_side_blank", "maxChars": 30 },
    { "index": 12, "label": "貸方補助科目", "required": false, "maxChars": 30 },
    { "index": 13, "label": "貸方部門", "required": false, "maxChars": 20 },
    { "index": 14, "label": "貸方取引先", "required": false, "maxChars": 255 },
    { "index": 15, "label": "貸方税区分", "required": "app_requires_explicit_approved_value_when_credit_side_present", "rule": "approved_profile_value_exact_match" },
    { "index": 16, "label": "貸方インボイス", "required": "app_requires_explicit_approved_value_when_credit_side_present", "allowed": ["適格", "80％控除", "70％控除", "50％控除", "30％控除", "控除なし"], "rule": "date_eligibility_required" },
    { "index": 17, "label": "貸方金額(円)", "required": "unless_compound_row_credit_side_blank", "rule": "positive_jpy_integer" },
    { "index": 18, "label": "貸方税額", "required": false, "allowed": ["", "0"] },
    { "index": 19, "label": "摘要", "required": false, "maxChars": 200 },
    { "index": 20, "label": "仕訳メモ", "required": false, "maxChars": 200 },
    { "index": 21, "label": "タグ", "required": false, "rule": "multiple_values_pipe_delimited" },
    { "index": 22, "label": "MF仕訳タイプ", "required": false, "allowed": ["", "インポート", "決算整理", "未実現", "開始仕訳", "家事按分", "償却", "請求書", "給与", "経費・債務支払", "債務", "記帳シス", "アプリ", "マネーフォワードME", "AI-OCR"], "rule": "multiple_values_pipe_delimited_and_same_for_compound_rows" },
    { "index": 23, "label": "決算整理仕訳", "required": false, "rule": "p0_outputs_blank" },
    { "index": 24, "label": "作成日時", "required": false, "rule": "always_blank" },
    { "index": 25, "label": "作成者", "required": false, "rule": "always_blank" },
    { "index": 26, "label": "最終更新日時", "required": false, "rule": "always_blank" },
    { "index": 27, "label": "最終更新者", "required": false, "rule": "always_blank" }
  ],
  "groupRules": [
    "header_labels_and_order_are_immutable",
    "each_row_has_at_least_one_complete_debit_or_credit_side",
    "account_and_amount_are_both_blank_or_both_present_on_each_side",
    "compound_rows_share_transaction_number_and_date",
    "compound_group_debit_total_equals_credit_total",
    "same_batch_duplicate_source_id_is_hard_block",
    "past_batch_same_source_set_or_hash_requires_explicit_confirmation_new_batch_id_and_supersedes_reference"
  ]
}
